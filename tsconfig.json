{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment / Module System */
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Strictness & Safety */
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}